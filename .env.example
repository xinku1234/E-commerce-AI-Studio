# Gemini API key. Leave empty to run the UI with local fallback/demo results.
GEMINI_API_KEY=

# Public URL of the application. Change this when deploying.
APP_URL=http://localhost:3000

# Express server port.
PORT=3000

# Production blocks localhost/private custom model endpoints by default.
# Enable only for a trusted private deployment that intentionally needs them.
ALLOW_PRIVATE_ENDPOINTS=false

# Require a usable AI model before generation workspaces can be used.
# Keep true for normal use; set false only for automated fallback/demo tests.
REQUIRE_MODEL=true

# Maximum accepted JSON/form payload. Increase only if your image workflow needs it.
REQUEST_BODY_LIMIT=20mb

# Set true only behind one trusted reverse proxy so rate limiting sees client IPs.
TRUST_PROXY=false
